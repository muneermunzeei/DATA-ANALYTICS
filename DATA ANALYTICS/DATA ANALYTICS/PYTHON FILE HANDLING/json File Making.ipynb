    "import json\n",
    "myself={\"Name\":\"Mufeeda\",\"Age\":21,\"Gender\":\"Female\",\"Place\":\"Vengara\",\"District\":\"Malappuram\"}\n",
    "with open(\"myself.json\",\"w\")as file:\n",
    "    json.dump(myself,file)\n",
    "\n",
    "with open(\"myself.json\",\"r\")as file:\n",
    "    print(json.load(file))\n"
